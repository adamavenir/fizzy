<% if cards.first.is_a?(BeadsIssue) %>
  <%= render partial: "cards/display/beads_preview", collection: cards, as: :card, locals: { draggable: local_assigns.fetch(:draggable, false) } %>
<% else %>
  <%= render partial: "cards/display/preview", collection: cards, as: :card, locals: { draggable: local_assigns.fetch(:draggable, false) }, cached: true %>
<% end %>
