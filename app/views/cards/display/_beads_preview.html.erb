<% draggable = local_assigns.fetch(:draggable, false) %>

<%= card_article_tag card, class: "card", draggable: draggable, data: { id: card.id, drag_and_drop_target: "item", navigable_list_target: "item" }, tabindex: 0 do %>
  <div class="flex flex-column flex-item-grow max-inline-size">
    <%= link_to issue_path(board_id: card.board.id, issue_id: card.id), draggable: false, class: "card__link", title: card.title, data: { action: "dialog#close", turbo_frame: "_top" } do %>
      <span class="for-screen-reader"><%= card.title %></span>
    <% end %>
    <header class="card__header">
      <label class="card__board">
        <span class="card__id">
          <span class="for-screen-reader">Card number</span>
          <%= card.number %>
        </span>
        <span class="card__board-name">
          <span class="overflow-ellipsis"><%= card.board.name %></span>
        </span>
      </label>

      <% if card.tags.any? %>
        <div class="card__tags">
          <%= icon_tag "tag-outline", class: "translucent" %>
          <div class="min-width overflow-ellipsis">
            <% card.tags.each_with_index do |tag, index| %>
              <span class="card__tag btn btn--plain overflow-ellipsis">
                <%= tag.title %><%= "," unless index == card.tags.size - 1 %>
              </span>
            <% end %>
          </div>
        </div>
      <% end %>
    </header>

    <div class="card__body justify-space-between">
      <div class="card__content">
        <h3 class="card__title overflow-line-clamp">
          <%= card.title || "Untitled" %>
        </h3>
      </div>
    </div>
  </div>

  <footer class="card__footer">
    <div class="card__meta">
      <div class="card__meta-avatars card__meta-avatars--author">
        <%= image_tag "logo.png", alt: card.creator.familiar_name, class: "avatar", size: 32 %>
      </div>

      <span class="card__meta-text card__meta-text--added">
        Added <%= local_datetime_tag(card.created_at, style: :daysago) if card.created_at %>
      </span>

      <span class="card__meta-text card__meta-text--author">
        <%= card.creator.familiar_name %>
      </span>

      <% if card.updated_at && card.updated_at != card.created_at %>
        <span class="card__meta-text card__meta-text--updated overflow-ellipsis">
          <%= icon_tag "refresh--meta", aria: { label: "Last updated" } %>
          <%= local_datetime_tag(card.updated_at, style: :daysago) %>
        </span>
      <% end %>

      <% if card.assignee.present? %>
        <span class="card__meta-text card__meta-text--assignees overflow-ellipsis">
          <%= icon_tag("arrow-right", aria: { label: "Assigned to" }) %>
          <% if (user = card.assignee_user) %>
            <%= user.familiar_name %>
          <% else %>
            <%= card.assignee %>
          <% end %>
        </span>
      <% end %>
    </div>
  </footer>

  <% if card.closed? %>
    <div class="card__closed">
      <span class="card__closed-title" data-text="Done">Done</span>
      <strong class="card__closed-date"><%= card.closed_at.strftime("%b %d, %Y") if card.closed_at %></strong>
    </div>
  <% elsif card.postponed? %>
    <div class="card__closed">
      <span class="card__closed-title" data-text="Not Now">Not Now</span>
    </div>
  <% end %>
<% end %>
