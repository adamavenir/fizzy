<div class="card-perma__actions card-perma__actions--right">
  <%= turbo_frame_tag card, :watch, src: issue_watch_path(board_id: card.board.id, issue_issue_id: card.id), target: "_top", refresh: :morph do %>
    <%= button_to issue_watch_path(board_id: card.board.id, issue_issue_id: card.id), class: "btn", data: { controller: "tooltip" } do %>
      <%= icon_tag "bell-off" %> <span class="for-screen-reader">Watch this</span>
    <% end %>
  <% end %>
  <%= turbo_frame_tag card, :pin, src: issue_pin_path(board_id: card.board.id, issue_issue_id: card.id), refresh: :morph do %>
    <%= button_to issue_pin_path(board_id: card.board.id, issue_issue_id: card.id), class: "btn", data: { controller: "tooltip" } do %>
      <%= icon_tag "unpinned" %> <span class="for-screen-reader">Pin this card</span>
    <% end %>
  <% end %>
</div>

<div class="card-perma__notch card-perma__notch--bottom flex-column" id="<%= dom_id(card, :card_closure_toggle) %>">
  <% if card.closed? %>
    <div class="flex gap-half margin-block-start-double margin-block-end">
      <span class="card-perma__closure-message">Closed <%= local_datetime_tag(card.closed_at, style: :shortdate) if card.closed_at %>.</span>
    </div>
  <% else %>
    <%= render "cards/container/closure_buttons", card: card %>

    <% if card.status.present? %>
      <div class="card-perma__closure-message margin-block-start">
        Status: <strong><%= card.status.upcase.gsub("_", " ") %></strong>
      </div>
    <% end %>
  <% end %>
</div>
