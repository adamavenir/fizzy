<% @page_title = "Edit: #{@issue.title}" %>
<% @header_class = "header--card" %>

<% content_for :header do %>
  <div class="header__actions header__actions--start">
    <%= link_to issue_path(board_id: @board.id, issue_id: @issue.id), class: "btn btn--plain txt-small" do %>
      <%= icon_tag "arrow-left" %>
      <span>Back to issue</span>
    <% end %>
  </div>
<% end %>

<div class="container">
  <section class="card-perma" style="--card-color: <%= @issue.color %>;">
    <div class="card-perma__bg">
      <%= form_with url: issue_path(board_id: @board.id, issue_id: @issue.id), method: :patch, class: "form" do |form| %>
        <div class="form__field">
          <%= form.label :title, "Title", class: "form__label" %>
          <%= form.text_field :title, value: @issue.title, class: "form__input txt-large", autofocus: true %>
        </div>

        <div class="form__field push-top">
          <%= form.label :description, "Description", class: "form__label" %>
          <p class="form__help txt-small translucent">Cover image managed separately - edit text only</p>
          <%= form.text_area :description, value: @issue.description_without_cover, class: "form__textarea", rows: 10, placeholder: "Markdown supported" %>
        </div>

        <div class="flex gap push-top">
          <div class="form__field flex-item-grow">
            <%= form.label :priority, "Priority", class: "form__label" %>
            <%= form.select :priority, options_for_select([
              ["Critical (P0)", 0],
              ["High (P1)", 1],
              ["Medium (P2)", 2],
              ["Low (P3)", 3],
              ["None (P4)", 4]
            ], @issue.priority), {}, class: "form__select" %>
          </div>

          <div class="form__field flex-item-grow">
            <%= form.label :issue_type, "Type", class: "form__label" %>
            <%= form.select :issue_type, options_for_select([
              ["Task", "task"],
              ["Bug", "bug"],
              ["Feature", "feature"],
              ["Epic", "epic"],
              ["Chore", "chore"]
            ], @issue.issue_type), {}, class: "form__select" %>
          </div>
        </div>

        <div class="form__field push-top">
          <%= form.label :assignee, "Assignee", class: "form__label" %>
          <% users = @board.account.users.includes(:identity).order(:name) %>
          <%= form.select :assignee, options_for_select(
            [["Unassigned", ""]] + users.map { |u| [u.name, u.identity.email_address] },
            @issue.assignee
          ), {}, class: "form__select" %>
        </div>

        <div class="form__actions push-top flex gap">
          <%= form.submit "Save changes", class: "btn btn--primary" %>
          <%= link_to "Cancel", issue_path(board_id: @board.id, issue_id: @issue.id), class: "btn" %>
        </div>
      <% end %>
    </div>
  </section>
</div>
