<div class="card-perma__actions card-perma__actions--right push-top">
  <%= link_to edit_issue_path(board_id: card.board.id, issue_id: card.id), class: "btn" do %>
    <%= icon_tag "pencil" %>
    <span>Edit</span>
  <% end %>

  <% unless card.closed? %>
    <%= button_to issue_closure_path(board_id: card.board.id, issue_issue_id: card.id), method: :post, class: "btn" do %>
      <%= icon_tag "checkmark" %>
      <span>Close</span>
    <% end %>
  <% end %>
</div>
