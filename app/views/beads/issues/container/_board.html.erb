<label class="card__board">
  <button
    type="button"
    class="card__id btn btn--plain"
    data-controller="copy-card-id"
    data-copy-card-id-text-value="#<%= card.id %>"
    data-action="click->copy-card-id#copy"
    title="Click to copy #<%= card.id %>">
    <span class="for-screen-reader">Issue ID (click to copy)</span>
    <%= card.number %>
  </button>
  <span class="card__board-name">
    <span class="overflow-ellipsis"><%= card.board.name %></span>
  </span>
</label>
