<% @page_title = @issue.title %>
<% @header_class = "header--card" %>

<%= turbo_stream_from @board %>

<% content_for :header do %>
  <div class="header__actions header__actions--start">
    <%= link_back_to_board(@issue.board) %>
  </div>
<% end %>

<div>
  <%= render "cards/container", card: @issue %>
  <%= render "beads/issues/related_cards", issue: @issue if @issue.has_related_cards? %>
  <%= render "cards/messages", card: @issue %>
</div>
